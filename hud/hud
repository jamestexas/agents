#!/usr/bin/env bash
# hud — one entry point for the work HUD, invokable from anywhere.
#
# A dispatcher, not a second implementation. Everything here already existed as
# a script, a node entry point, or two lines of launchctl; what did not exist
# was a way to reach any of it without first remembering where the machinery is
# checked out. `hud` resolves its own symlink, so one link into a directory on
# PATH makes every subcommand below work from any directory.
#
# Ports, hosts, labels, and upstreams come from $HUD_ROOT/hud.toml, read
# through the server's own loadConfig() — the same posture service/install.sh
# takes, and for the same reason: the shell has no reader for that format and a
# second parser is a second thing to keep correct. Nothing is hardcoded here
# except the fallbacks that apply when the config is absent entirely.
#
# Usage:
#   hud <command> [args]
#
#   init [--root DIR] [--yes] [--dry-run]
#                create a new content tree and its hud.toml — the command a new
#                user runs first, and the only one here that makes a tree
#                rather than talking to one. It PROBES for each source and
#                configures only what is actually there; every source it could
#                not find is written into the same file as a commented stub
#                carrying the reason and what to install, so a grey panel
#                always has its explanation next to its own config. Never
#                clobbers an existing tree, never overwrites a hud.toml, and
#                never creates a git remote — it prints that command instead.
#                --dry-run prints the whole plan and writes nothing at all.
#                Key-by-key reference: docs/SOURCES.md.
#   new <kind> [--title T] [--project P] [--handle H] [--slug S] [--date D]
#       [--set KEY=VALUE]... [--body TEXT | --body-file PATH] [--ext EXT]
#       [--summary TEXT] [--dry-run] [--json]
#                write one entry into the CONTENT tree — the only verb here
#                that authors content. State the intent and it derives the
#                rest: which of the six shapes the kind is, the directory that
#                shape lives in, the YYYY-MM-DD prefix, the kebab slug from the
#                title, and the frontmatter keys legal for that kind — then
#                makes the two bookkeeping appends (index.md, log.md) that
#                every write owes the tree. Kinds: note, inbox, playbook,
#                context, peer, raw. A frontmatter key not legal for the kind
#                is REFUSED rather than written, and a note whose project
#                cannot be resolved is filed under inbox/ rather than guessed
#                at. It writes $HUD_ROOT directly: the server is watch-only and
#                has no write route. --dry-run prints the whole plan and writes
#                nothing; --json emits one document (schema hud-new/v1) for
#                success and for refusal alike. Per-kind reference: docs/CLI.md.
#   start        start the HUD — the launchd service if one is installed,
#                otherwise `node server.mjs` backgrounded. Idempotent. If a
#                process this script did not start holds the port, it refuses
#                and prints the pid rather than killing it.
#   stop         stop the HUD. The service is booted out rather than killed,
#                because KeepAlive would restart it; the plist stays, so
#                `hud start` brings the same service back.
#   restart      stop, then start
#   status [--json]
#                what is actually true right now: resolved HUD_ROOT and config,
#                service state and pid, port and health, whether the tree is
#                backed up to its git remote, and whether each configured
#                upstream answers. Always exits 0 — it reports state, it does
#                not assert it. --json emits the same facts as one document
#                (schema hud-status/v1); the exit code is the same.
#   open         open the HUD in your browser
#   logs [-f] [-n N]
#                tail the server log ($HUD_ROOT/.generated/service.log)
#   root         print the resolved HUD_ROOT
#   sync [-m MSG] [--dry-run]
#                back the CONTENT tree up: stage it, commit, and push to its
#                git remote, in one verb, so "did I commit my notes" stops
#                being something you remember. A clean, in-sync tree is not an
#                error — it says there is nothing to sync and exits 0. It never
#                force-pushes: if the remote moved ahead it refuses and tells
#                you to pull. --dry-run names exactly what would be staged,
#                committed and pushed and changes nothing, here or there.
#   pull [--dry-run]
#                bring read-only stores up to date: fast-forward only, never on
#                a dirty tree, and never touching the writable store. The
#                mirror of sync — sync pushes the one store you own and reads
#                no other; pull reads the others and writes none. Reports one
#                of updated | current | skipped | refused per store, and exits
#                non-zero only if something was refused. --dry-run uses
#                ls-remote, so it writes nothing, not even to .git.
#
#   install      install the launchd SERVICE, so the HUD runs without you
#                (service/install.sh). Does NOT put `hud` on your PATH.
#   uninstall    remove that SERVICE (service/uninstall.sh); args pass through
#   link         put this COMMAND on your PATH, by symlinking this script into
#                $XDG_BIN_HOME (else ~/.local/bin). Installs no service.
#   unlink       remove that COMMAND symlink, if it points at this checkout
#
#   index        rebuild the mache index (hud-index.mjs)
#   smoke        integration gate against the real tree (smoke.sh)
#   test         hermetic unit suite (node --test test/)
#
#   --help, -h   this text
#
# An unreachable upstream is a normal state, not a failure: the HUD greys the
# panel out and keeps serving, and `hud status` prints the fact and exits 0.
#
# `link` and `install` are about the MACHINERY and you run them once: one puts
# this command on your PATH, the other puts a service in launchd. `sync` is
# about your CONTENT and you run it constantly; it installs nothing, starts
# nothing, and is the only verb here that writes to the tree's git history or
# talks to a remote.
#
# Environment: HUD_ROOT selects the content tree (default ~/hud). HUD_PORT,
# HUD_HOST, and HUD_LABEL override the [serve] table, as they do everywhere
# else in the HUD. XDG_BIN_HOME picks the directory `link` installs into
# (default ~/.local/bin); HUD_LINK_DIR overrides both for a one-off.

set -euo pipefail

# Print the contiguous comment header after the shebang. Deriving the range
# from the file itself keeps --help correct when the header grows or shrinks; a
# fixed `sed -n '2,Np'` silently starts printing code the moment it moves.
usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SELF_ABS"
    exit "${1:-0}"
}

die() { printf 'hud: %s\n' "$*" >&2; exit 1; }

# Resolve the symlink chain before taking a dirname: `link` puts this file on
# PATH as a symlink, and dirname of the *link* points at ~/.local/bin, where no
# machinery lives. `pwd -P` at the end because server.mjs only self-starts when
# argv[1] matches the URL node loaded it from, and node resolves symlinks while
# argv does not — the same trap service/install.sh documents.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
    self_dir="$(cd -P -- "$(dirname -- "$SELF")" && pwd)"
    SELF="$(readlink -- "$SELF")"
    [[ "$SELF" == /* ]] || SELF="$self_dir/$SELF"
done
MACHINERY_DIR="$(cd -P -- "$(dirname -- "$SELF")" && pwd)"
SERVER_JS="$MACHINERY_DIR/server.mjs"

# The absolute path to this script. $SELF is whatever argv named — `./hud/hud`
# stays relative, and a symlink whose text is a relative path is resolved
# against the *link's* directory, not the caller's cwd. `link` must write an
# absolute target and compare absolute paths, so it uses this, never $SELF.
SELF_ABS="$MACHINERY_DIR/$(basename -- "$SELF")"

# Follow a symlink chain to the file it ultimately names, absolute. Same walk
# as the SELF resolution above, for the same reason: comparing raw `readlink`
# output against an absolute path answers the wrong question. A dangling link
# reports the path it names rather than failing — that is a state `link` has to
# describe, not choke on. The hop bound is a cycle guard: `[[ -L ]]` is an
# lstat and will not detect one for us.
resolve_path() {
    local p="$1" dir hops=0
    while [[ -L "$p" ]] && (( hops++ < 40 )); do
        dir="$(cd -P -- "$(dirname -- "$p")" && pwd)"
        p="$(readlink -- "$p")"
        # ${dir%/} because dirname of a top-level path is "/": joining naively
        # yields "//x", which macOS's pwd preserves (a leading "//" is
        # implementation-defined) and which would then never compare equal to
        # the same file named the ordinary way.
        [[ "$p" == /* ]] || p="${dir%/}/$p"
    done
    if dir="$(cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd)"; then
        printf '%s/%s\n' "${dir%/}" "$(basename -- "$p")"
    else
        printf '%s\n' "$p"
    fi
}

# ------------------------------------------------------------------ config

# One node call reads the whole config, because loadConfig() is the only parser
# for hud.toml and calling it per key would pay for the import five times. The
# server's path travels in the environment, not argv: server.mjs self-starts
# when argv[1] names it, so passing its path would leave this probe trying to
# bind the port it was called to inspect.
CONFIG_PROBE='
import { pathToFileURL } from "node:url";
const m = await import(pathToFileURL(process.env.HUD_CFG_SERVER).href);
const root = m.defaultRoot();
const detail = m.loadConfigDetail(root);
const cfg = detail.data || {};
const table = (o, n) => (o && typeof o[n] === "object" && o[n] ? o[n] : {});
const serve = table(cfg, "serve");
const sources = table(cfg, "sources");
const emit = (k, v) => {
  if (v === undefined || v === null || v === "") return;
  process.stdout.write(k + "\t" + String(v).replace(/[\t\r\n]/g, " ") + "\n");
};
emit("root", root);
emit("config.file", detail.file);
emit("config.name", m.CONFIG_TOML);
emit("known.sections", (m.KNOWN_SECTIONS || []).join(" "));
for (const w of detail.warns || []) emit("config.warn", w);
emit("default.port", m.DEFAULT_PORT);
emit("serve.host", serve.host);
emit("serve.port", serve.port);
emit("serve.label", serve.label);
emit("board.url", table(sources, "board").url);
emit("digest.cmd", table(sources, "digest").cmd);
const sroot = table(sources, "sessions").root;
emit("sessions.root", sroot ? m.expandHome(String(sroot)) : "");
emit("sessions.lectio", table(sources, "sessions").lectio);
// Read-only stores come from the module rather than the raw config: the
// rejections (absent path, reserved name, not a directory) are decided there,
// and a warning nobody prints is the same as no warning at all.
const rs = m.readStores(root);
for (const st of rs.stores) emit("read.store", st.name + " " + st.path);
for (const w of rs.warns) emit("read.warn", w);
'

CFG_LOADED=""
CFG_FILE="" CFG_NAME="" CFG_DEFAULT_PORT="" CFG_HOST="" CFG_PORT="" CFG_LABEL=""
BOARD_URL="" DIGEST_CMD="" SESSIONS_ROOT="" LECTIO_URL=""
KNOWN_SECTIONS=""
CONFIG_WARNS=()
READ_STORES=()
READ_WARNS=()

load_config() {
    [[ -z "$CFG_LOADED" ]] || return 0
    command -v node >/dev/null 2>&1 || die "no 'node' on PATH — the HUD server needs it."
    [[ -f "$SERVER_JS" ]] || die "missing $SERVER_JS"

    local key value
    while IFS=$'\t' read -r key value; do
        case "$key" in
            root) HUD_ROOT_R="$value" ;;
            config.file) CFG_FILE="$value" ;;
            config.name) CFG_NAME="$value" ;;
            known.sections) KNOWN_SECTIONS="$value" ;;
            config.warn) CONFIG_WARNS+=("$value") ;;
            read.store) READ_STORES+=("$value") ;;
            read.warn) READ_WARNS+=("$value") ;;
            default.port) CFG_DEFAULT_PORT="$value" ;;
            serve.host) CFG_HOST="$value" ;;
            serve.port) CFG_PORT="$value" ;;
            serve.label) CFG_LABEL="$value" ;;
            board.url) BOARD_URL="$value" ;;
            digest.cmd) DIGEST_CMD="$value" ;;
            sessions.root) SESSIONS_ROOT="$value" ;;
            sessions.lectio) LECTIO_URL="$value" ;;
        esac
    done < <(HUD_CFG_SERVER="$SERVER_JS" node --input-type=module -e "$CONFIG_PROBE" || true)

    [[ -n "${HUD_ROOT_R:-}" ]] || die "could not read the HUD config through $SERVER_JS"
    # Match install.sh: the plist was written with a resolved root, so a
    # symlinked HUD_ROOT must resolve the same way or the log path printed here
    # names a file nothing writes to.
    HUD_ROOT_R="$(cd -- "$HUD_ROOT_R" 2>/dev/null && pwd -P || printf '%s' "$HUD_ROOT_R")"

    # The environment wins over the file, everywhere in the HUD.
    HOST="${HUD_HOST:-${CFG_HOST:-127.0.0.1}}"
    PORT="${HUD_PORT:-${CFG_PORT:-${CFG_DEFAULT_PORT:-4870}}}"
    LABEL="${HUD_LABEL:-${CFG_LABEL:-local.hud}}"
    if [[ ! "$PORT" =~ ^[0-9]+$ ]] || (( PORT < 1 || PORT > 65535 )); then
        die "port $PORT is not a valid port number."
    fi

    URL="http://${HOST}:${PORT}/"
    DOMAIN="gui/$(id -u)"
    TARGET="${DOMAIN}/${LABEL}"
    PLIST="${HOME}/Library/LaunchAgents/${LABEL}.plist"
    # Generated state stays under the content tree — NOT in XDG_STATE_HOME or
    # XDG_DATA_HOME, and this is deliberate. The HUD's split is public code /
    # private data: the machinery is a checkout, everything the HUD produces
    # about your work (this log, the peers snapshot, the mache index) belongs to
    # the tree it describes, travels with it, and is gitignored there. A
    # per-user XDG dir would scatter one tree's output across a location shared
    # by every tree, and would break `HUD_ROOT=other-tree hud logs`. hud.toml
    # stays in the tree for the same reason: it is per-tree config, not per-user
    # config. Only the `link` target below is an XDG concern, because the
    # command on your PATH genuinely is per-user.
    LOG_DIR="${HUD_ROOT_R}/.generated"
    LOG_FILE="${LOG_DIR}/service.log"
    CFG_LOADED=yes
}

# ------------------------------------------------------------------ probes

have_launchd() { [[ "$(uname -s)" == "Darwin" ]] && command -v launchctl >/dev/null 2>&1; }
service_loaded() { have_launchd && launchctl print "$TARGET" >/dev/null 2>&1; }

# Empty when there is no such service. `launchctl print` exits 113 for an
# unknown label, and with pipefail that status is the pipeline's, so without the
# `|| true` every caller inherits a failure for the ordinary "not installed"
# case — which is precisely the state `hud status` exists to report.
service_pid() {
    have_launchd || return 0
    launchctl print "$TARGET" 2>/dev/null |
        awk '$1 == "pid" && $2 == "=" { print $3; exit }' || true
}

port_holder() { lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }

# Whether a pid is a HUD server rather than an unrelated squatter. The launchd
# agent and a backgrounded `node server.mjs` both carry the resolved server
# path in their argv, which is exactly what makes them ours to stop.
is_hud_server() {
    [[ -n "$1" ]] && ps -o command= -p "$1" 2>/dev/null | grep -qF "$SERVER_JS"
}

# `000` is curl's code for "never got a response", which is how an upstream
# that is simply not running reports itself. Not an error here.
http_code() { curl -s -o /dev/null -w '%{http_code}' --max-time "${2:-3}" "$1" 2>/dev/null || true; }

# Whether anything answers at a URL, with the code it answered with left in
# HTTP_ANSWER_CODE. Three outcomes, not two, because "we did not look" is a
# different claim from "it is down":
#
#   0  answering            1  not answering            2  could not look
#
# `hud status` and `hud init` both ask this question — of a configured upstream
# and of a candidate one respectively — so they ask it through one function.
# Two probes that could disagree about what "reachable" means would be a way to
# hand someone a config init called good and status calls dead.
HTTP_ANSWER_CODE=""
http_answers() {
    HTTP_ANSWER_CODE=""
    command -v curl >/dev/null 2>&1 || return 2
    HTTP_ANSWER_CODE="$(http_code "$1")"
    [[ -n "$HTTP_ANSWER_CODE" && "$HTTP_ANSWER_CODE" != "000" ]]
}

# The first token of a configured command — the part that has to be on PATH.
# The server tokenizes the whole command properly and runs it without a shell;
# this is a "can it be found" check and never an invocation, so neither `status`
# nor `init` ever runs your digest.
cmd_head() { local head; read -r head _ <<<"$1"; printf '%s\n' "$head"; }

wait_healthy() {
    local _
    for _ in $(seq 1 40); do
        if curl -fs -o /dev/null --max-time 2 "$URL"; then return 0; fi
        sleep 0.5
    done
    return 1
}

# ---------------------------------------------------------------- commands

cmd_start() {
    load_config
    local holder
    holder="$(port_holder)"
    if [[ -n "$holder" ]]; then
        if is_hud_server "$holder"; then
            printf 'already serving %s (pid %s)\n' "$URL" "$holder"
            return 0
        fi
        printf 'hud: port %s is held by pid %s, which this script did not start:\n\n' \
            "$PORT" "$holder" >&2
        ps -o pid=,command= -p "$holder" >&2 || true
        printf '\nStop it yourself, or pick another port (HUD_PORT=... or [serve] port).\n' >&2
        exit 1
    fi

    if service_loaded; then
        launchctl kickstart "$TARGET" >/dev/null
        printf 'kickstarted %s\n' "$LABEL"
    elif have_launchd && [[ -f "$PLIST" ]]; then
        # The plist exists but launchd has forgotten it — the state `hud stop`
        # leaves behind. Loading a file install.sh already rendered is not a
        # second installer; `hud install` remains the only thing that writes one.
        launchctl bootstrap "$DOMAIN" "$PLIST"
        printf 'loaded %s from %s\n' "$LABEL" "$PLIST"
    else
        [[ -f "$SERVER_JS" ]] || die "missing $SERVER_JS"
        mkdir -p -- "$LOG_DIR"
        printf "no launchd agent installed — starting 'node server.mjs' in the background\n"
        HUD_ROOT="$HUD_ROOT_R" HUD_PORT="$PORT" \
            nohup node "$SERVER_JS" >>"$LOG_FILE" 2>&1 &
    fi

    if wait_healthy; then
        printf 'serving %s\n' "$URL"
    else
        printf 'hud: started, but %s did not answer within 20s. Last log lines:\n' "$URL" >&2
        tail -20 -- "$LOG_FILE" >&2 || true
        exit 1
    fi
}

cmd_stop() {
    load_config
    if service_loaded; then
        # bootout, not kill: KeepAlive means launchd restarts anything killed,
        # so a kill is a restart with extra steps.
        launchctl bootout "$TARGET" 2>/dev/null || true
        local _
        for _ in $(seq 1 20); do
            service_loaded || break
            sleep 0.25
        done
        if service_loaded; then
            die "$TARGET is still registered with launchd"
        fi
        printf "service %s stopped (plist kept — 'hud start' reloads it)\n" "$LABEL"
        return 0
    fi

    local holder
    holder="$(port_holder)"
    if [[ -z "$holder" ]]; then
        printf 'not running (nothing listening on port %s)\n' "$PORT"
        return 0
    fi
    if ! is_hud_server "$holder"; then
        printf 'hud: pid %s holds port %s and is not a HUD server — not ours to kill:\n' \
            "$holder" "$PORT" >&2
        ps -o pid=,command= -p "$holder" >&2 || true
        exit 1
    fi
    kill "$holder"
    local _
    for _ in $(seq 1 20); do
        [[ -z "$(port_holder)" ]] && break
        sleep 0.25
    done
    printf 'stopped node server.mjs (pid %s)\n' "$holder"
}

cmd_restart() {
    cmd_stop
    cmd_start
}

# ------------------------------------------------------------- upstreams
#
# Probed once into one table, then rendered either as lines or as JSON. The
# point of giving the machine a format is that it agrees with what the human is
# told, and two renderers reading one table is the only way that stays true
# without anyone remembering to keep them in step.
#
# `status` is a closed four-state vocabulary, the same shape scripts/pr-context.sh
# emits and for the same reason: a consumer tests one field and never has to
# infer meaning from an empty value.
#   ok           probed, and answering
#   unreachable  probed, and did not answer / does not exist
#   absent       not configured — there is no panel to serve
#   skipped      configured, but not probed; `reason` says what prevented it
# The words are not pr-context.sh's (`empty`/`unavailable`) because the question
# is not the same one: that tool asks whether a query returned rows, this one
# asks whether the thing on the other end is there. What the two tools share is
# the contract — every entry carries exactly one status, drawn from a fixed set,
# and a reason that is never blank.
UP_NAMES=() UP_TARGETS=() UP_STATUSES=() UP_REASONS=()

# add_upstream <name> <target> <status> <reason>. An empty target means "not
# configured": the human view prints `-`, the JSON view prints null.
add_upstream() {
    UP_NAMES+=("$1"); UP_TARGETS+=("$2"); UP_STATUSES+=("$3"); UP_REASONS+=("$4")
}

# The `skipped` state is where "no curl" lands: we did not look, which is not
# the same claim as "it is down".
probe_http_upstream() {
    local name="$1" url="$2" rc=0
    http_answers "$url" || rc=$?
    case "$rc" in
        0) add_upstream "$name" "$url" ok "HTTP $HTTP_ANSWER_CODE" ;;
        2) add_upstream "$name" "$url" skipped "curl not found — not probed" ;;
        *) add_upstream "$name" "$url" unreachable "panel greys out" ;;
    esac
}

probe_upstreams() {
    UP_NAMES=() UP_TARGETS=() UP_STATUSES=() UP_REASONS=()

    if [[ -n "$BOARD_URL" ]]; then
        probe_http_upstream board "$BOARD_URL"
    else
        add_upstream board "" absent "no panel"
    fi

    if [[ -n "$DIGEST_CMD" ]]; then
        local digest_bin
        digest_bin="$(cmd_head "$DIGEST_CMD")"
        if command -v "$digest_bin" >/dev/null 2>&1; then
            add_upstream digest "$DIGEST_CMD" ok "$digest_bin on PATH"
        else
            add_upstream digest "$DIGEST_CMD" unreachable "$digest_bin not on PATH"
        fi
    else
        add_upstream digest "" absent "no panel"
    fi

    if [[ -n "$SESSIONS_ROOT" ]]; then
        if [[ -d "$SESSIONS_ROOT" ]]; then
            add_upstream sessions "$SESSIONS_ROOT" ok "directory"
        else
            add_upstream sessions "$SESSIONS_ROOT" unreachable "no such directory"
        fi
    else
        add_upstream sessions "" absent "no panel"
    fi

    if [[ -n "$LECTIO_URL" ]]; then
        probe_http_upstream lectio "$LECTIO_URL"
    else
        add_upstream lectio "" absent "sessions stay tier-1"
    fi
}

# One line per upstream: what it is, where it points, and whether it answers.
# `absent` reads as "not configured" to a human; the JSON keeps the vocabulary
# word, because that is the field a program matches on.
report_upstreams() {
    local i label
    for i in ${UP_NAMES[@]+"${!UP_NAMES[@]}"}; do
        case "${UP_STATUSES[$i]}" in
            absent) label="not configured" ;;
            *) label="${UP_STATUSES[$i]}" ;;
        esac
        printf '  %-9s %-38s %s (%s)\n' \
            "${UP_NAMES[$i]}" "${UP_TARGETS[$i]:--}" "$label" "${UP_REASONS[$i]}"
    done
}

# ---------------------------------------------------------------- backup
#
# The upstream table above answers "is the HUD working". This answers the other
# question you have while looking at it — "is my knowledge safe" — which is a
# fact about the content tree's git remote, not about any panel. It sits in the
# same command because the two are checked at the same moment and for the same
# reason, and because a backup you have to remember to check is one you will
# not check.
#
# On the watch-only invariant: the HUD never acts on a PR, a ticket, or a
# session, and that does not change here. The invariant governs EXTERNAL
# surfaces — someone else's repository, someone else's queue — which the HUD
# only ever reads and links out to. Pushing your own tree to your own remote is
# not acting on someone else's surface; it is authoring, the same category as
# writing the note in the first place. `hud status` still only reads: `sync` is
# a separate, explicit verb, and it is the only one in this script that writes
# anything outside $HUD_ROOT/.generated/.
#
# BACKUP_STATUS is a closed five-state vocabulary, the same contract the
# upstream table keeps — exactly one word from a fixed set, and a reason that is
# never blank:
#   synced    a remote is configured, and everything committed here is on it
#   unpushed  work exists only on this machine (uncommitted, or committed and
#             not pushed, or a branch with no upstream yet)
#   diverged  the remote holds commits this tree does not — pull before syncing
#   absent    no remote configured; this tree is not backed up anywhere
#   unknown   could not tell — `reason` says what stopped us (no git, not a repo)
#
# ahead/behind come from the local remote-tracking ref, so they are as fresh as
# your last fetch and this probe stays offline: `hud status` must not block on
# the network to tell you the service is down. `hud sync` asks the remote
# itself, because acting on a stale answer is how you force-push by accident.
BACKUP_STATUS="" BACKUP_REASON="" BACKUP_REMOTE="" BACKUP_URL=""
BACKUP_BRANCH="" BACKUP_UPSTREAM="" BACKUP_AHEAD="" BACKUP_BEHIND="" BACKUP_DIRTY=""

# git in the content tree. Always -C: the caller's cwd is wherever they ran
# `hud` from, which is the whole point of the command being on PATH.
git_tree() { git -C "$HUD_ROOT_R" "$@"; }

set_backup() { BACKUP_STATUS="$1"; BACKUP_REASON="$2"; }

probe_backup() {
    BACKUP_STATUS="" BACKUP_REASON="" BACKUP_REMOTE="" BACKUP_URL=""
    BACKUP_BRANCH="" BACKUP_UPSTREAM="" BACKUP_AHEAD="" BACKUP_BEHIND="" BACKUP_DIRTY=""

    if ! command -v git >/dev/null 2>&1; then
        set_backup unknown "git not found — not probed"
        return 0
    fi
    if ! git_tree rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        set_backup unknown "not a git repository — 'git init' makes backup possible"
        return 0
    fi

    # Empty on a detached HEAD, which is a state to report rather than choke on.
    BACKUP_BRANCH="$(git_tree symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
    # Scoped to the tree's own subtree with `-- .`, so a HUD_ROOT that happens to
    # live inside a larger repository reports on itself rather than on its host.
    BACKUP_DIRTY="$(git_tree status --porcelain --untracked-files=all -- . 2>/dev/null | wc -l | tr -d ' ')"

    if [[ -n "$BACKUP_BRANCH" ]]; then
        # for-each-ref rather than parsing `@{upstream}`: it reports the remote
        # NAME as its own field, so a remote whose name contains a slash does not
        # silently become a wrong answer.
        BACKUP_UPSTREAM="$(git_tree for-each-ref --format='%(upstream:short)' \
            "refs/heads/$BACKUP_BRANCH" 2>/dev/null || true)"
        BACKUP_REMOTE="$(git_tree for-each-ref --format='%(upstream:remotename)' \
            "refs/heads/$BACKUP_BRANCH" 2>/dev/null || true)"
    fi
    # No upstream yet is the state right after `git remote add`, and it still has
    # a remote to name. Prefer origin, else the only remote there is; two
    # remotes and no upstream is genuinely ambiguous, so say so rather than guess.
    if [[ -z "$BACKUP_REMOTE" ]]; then
        local remotes=() r
        while IFS= read -r r; do [[ -n "$r" ]] && remotes+=("$r"); done \
            < <(git_tree remote 2>/dev/null || true)
        for r in ${remotes[@]+"${remotes[@]}"}; do
            [[ "$r" == origin ]] && BACKUP_REMOTE=origin
        done
        if [[ -z "$BACKUP_REMOTE" && ${#remotes[@]} -eq 1 ]]; then
            BACKUP_REMOTE="${remotes[0]}"
        fi
        if [[ -z "$BACKUP_REMOTE" && ${#remotes[@]} -gt 1 ]]; then
            set_backup unpushed "several remotes and no upstream — 'git push -u <remote> $BACKUP_BRANCH' once"
            return 0
        fi
    fi

    if [[ -z "$BACKUP_REMOTE" ]]; then
        set_backup absent "no git remote — 'git remote add origin <url>', then 'hud sync'"
        return 0
    fi
    BACKUP_URL="$(git_tree remote get-url "$BACKUP_REMOTE" 2>/dev/null || true)"

    if [[ -z "$BACKUP_BRANCH" ]]; then
        set_backup unknown "HEAD is detached — check out a branch to back up"
        return 0
    fi
    if [[ -z "$BACKUP_UPSTREAM" ]]; then
        set_backup unpushed "$BACKUP_BRANCH has no upstream on $BACKUP_REMOTE yet — 'hud sync' sets it"
        return 0
    fi

    # `upstream...HEAD` with --left-right --count: left is what only the upstream
    # has (behind), right is what only we have (ahead).
    local counts
    if counts="$(git_tree rev-list --left-right --count \
            "$BACKUP_UPSTREAM...HEAD" 2>/dev/null)"; then
        read -r BACKUP_BEHIND BACKUP_AHEAD <<<"$counts"
    fi
    if [[ -z "$BACKUP_AHEAD" || -z "$BACKUP_BEHIND" ]]; then
        set_backup unknown "no $BACKUP_UPSTREAM ref locally — fetch once to compare"
        return 0
    fi

    # Only the nonzero halves get named. "0 commit(s) + 3 uncommitted" makes the
    # reader do arithmetic to find the one number that was the answer.
    local local_work=""
    (( BACKUP_AHEAD > 0 )) && local_work="$BACKUP_AHEAD commit(s)"
    (( BACKUP_DIRTY > 0 )) && local_work="${local_work:+$local_work + }$BACKUP_DIRTY uncommitted change(s)"

    if (( BACKUP_BEHIND > 0 )); then
        set_backup diverged "$BACKUP_UPSTREAM has $BACKUP_BEHIND commit(s) this tree does not${local_work:+, and $local_work here} — pull before syncing"
    elif [[ -n "$local_work" ]]; then
        set_backup unpushed "$local_work only on this machine — 'hud sync'"
    else
        set_backup synced "everything here is on $BACKUP_UPSTREAM (as of your last fetch)"
    fi
}

# One line, in the same column grid as the lines above it: where the backup
# goes, and whether your work is actually there.
report_backup() {
    local target="${BACKUP_URL:-}" detail
    case "$BACKUP_STATUS" in
        absent) target="none — not backed up" ;;
        unknown) target="${BACKUP_URL:-n/a}" ;;
    esac
    if [[ -n "$BACKUP_REMOTE" ]]; then
        detail="$BACKUP_REMOTE: $BACKUP_REASON"
    else
        detail="$BACKUP_REASON"
    fi
    printf '  backup    %-38s %s\n' "$target" "$detail"
}

# The JSON view. It exists for what the HTTP API does not expose: the HUD's
# /api/* routes already serve tree and panel data machine-readably, but nothing
# over HTTP can tell you about the service, how the config resolved, or where
# the CLI is installed — and all three are the things you want a program to see
# when the HUD is NOT answering. jq is required only on this path, so the human
# default keeps working on a box without it.
emit_status_json() {  # port-holder pid, HTTP code, service pid
    command -v jq >/dev/null 2>&1 || die "status --json needs jq on PATH"
    local holder="$1" code="$2" pid="$3"

    local ups='[]' i
    for i in ${UP_NAMES[@]+"${!UP_NAMES[@]}"}; do
        ups="$(jq --arg n "${UP_NAMES[$i]}" --arg t "${UP_TARGETS[$i]}" \
                  --arg s "${UP_STATUSES[$i]}" --arg r "${UP_REASONS[$i]}" \
                  '. + [{name: $n,
                         target: (if $t == "" then null else $t end),
                         status: $s,
                         reason: $r}]' <<<"$ups")"
    done

    local warns='[]' w
    for w in ${CONFIG_WARNS[@]+"${CONFIG_WARNS[@]}"}; do
        warns="$(jq --arg w "$w" '. + [$w]' <<<"$warns")"
    done

    # Numbers reach jq as JSON literals, so anything that is not a number
    # becomes null rather than a string that a consumer has to re-parse. `000`
    # is curl's "no response" sentinel, not an HTTP status, so it is null too.
    local code_json=null holder_json=null pid_json=null
    [[ "$code" =~ ^[0-9]+$ && "$code" != "000" ]] && code_json="$code"
    [[ "$holder" =~ ^[0-9]+$ ]] && holder_json="$holder"
    [[ "$pid" =~ ^[0-9]+$ ]] && pid_json="$pid"

    local holder_is_hud=false svc_available=false svc_loaded=false plist_present=false
    if [[ -n "$holder" ]] && is_hud_server "$holder"; then holder_is_hud=true; fi
    if have_launchd; then svc_available=true; fi
    if service_loaded; then svc_loaded=true; fi
    if [[ -f "$PLIST" ]]; then plist_present=true; fi

    local dir dest target="" linked=false on_path=false
    dir="$(link_target_dir)"
    dest="$dir/hud"
    if [[ -L "$dest" ]]; then
        target="$(resolve_path "$dest")"
        [[ "$target" == "$SELF_ABS" ]] && linked=true
    elif [[ -e "$dest" ]]; then
        target="$dest"
    fi
    case ":${PATH}:" in *":$dir:"*) on_path=true ;; esac

    # Same rule as the numbers above: a count that could not be determined is
    # null, never 0 and never a string. "behind is null" and "behind is 0" are
    # different claims, and a consumer deciding whether your notes are safe
    # needs to be able to tell them apart.
    local ahead_json=null behind_json=null dirty_json=null
    [[ "$BACKUP_AHEAD" =~ ^[0-9]+$ ]] && ahead_json="$BACKUP_AHEAD"
    [[ "$BACKUP_BEHIND" =~ ^[0-9]+$ ]] && behind_json="$BACKUP_BEHIND"
    [[ "$BACKUP_DIRTY" =~ ^[0-9]+$ ]] && dirty_json="$BACKUP_DIRTY"

    local backup
    backup="$(jq -n \
        --arg status "$BACKUP_STATUS" \
        --arg reason "$BACKUP_REASON" \
        --arg remote "$BACKUP_REMOTE" \
        --arg url "$BACKUP_URL" \
        --arg branch "$BACKUP_BRANCH" \
        --arg upstream "$BACKUP_UPSTREAM" \
        --argjson ahead "$ahead_json" \
        --argjson behind "$behind_json" \
        --argjson dirty "$dirty_json" \
        '{status: $status,
          reason: $reason,
          configured: ($remote != ""),
          remote: (if $remote == "" then null else $remote end),
          url: (if $url == "" then null else $url end),
          branch: (if $branch == "" then null else $branch end),
          upstream: (if $upstream == "" then null else $upstream end),
          ahead: $ahead,
          behind: $behind,
          dirty: $dirty}')"

    # Stores, in the order the server resolves them: writable first, then each
    # read-only mount, then anything refused. A rejection is a row with
    # status "ignored" rather than an omission, so a consumer can tell a
    # machine with no mounts from one whose mounts all failed.
    local stores entry nm pth
    stores="$(jq -n --arg root "$HUD_ROOT_R" \
        '[{name: "local", writable: true, path: $root, status: "ok", reason: null}]')"
    for entry in ${READ_STORES[@]+"${READ_STORES[@]}"}; do
        nm="${entry%% *}"
        pth="${entry#* }"
        stores="$(jq -n --argjson acc "$stores" --arg name "$nm" --arg path "$pth" \
            '$acc + [{name: $name, writable: false, path: $path, status: "ok", reason: null}]')"
    done
    for entry in ${READ_WARNS[@]+"${READ_WARNS[@]}"}; do
        stores="$(jq -n --argjson acc "$stores" --arg reason "$entry" \
            '$acc + [{name: null, writable: false, path: null, status: "ignored", reason: $reason}]')"
    done

    jq -n \
        --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg root "$HUD_ROOT_R" \
        --argjson stores "$stores" \
        --arg config_file "$CFG_FILE" \
        --argjson config_warnings "$warns" \
        --arg url "$URL" \
        --argjson port "$PORT" \
        --argjson http_code "$code_json" \
        --argjson holder_pid "$holder_json" \
        --argjson holder_is_hud "$holder_is_hud" \
        --arg service_label "$LABEL" \
        --argjson service_available "$svc_available" \
        --argjson service_loaded "$svc_loaded" \
        --argjson service_pid "$pid_json" \
        --arg plist "$PLIST" \
        --argjson plist_present "$plist_present" \
        --arg log "$LOG_FILE" \
        --arg link_dir "$dir" \
        --arg link_path "$dest" \
        --arg link_target "$target" \
        --argjson link_linked "$linked" \
        --argjson link_on_path "$on_path" \
        --argjson backup "$backup" \
        --argjson upstreams "$ups" \
        '{schema: "hud-status/v1",
          generated_at: $generated_at,
          root: $root,
          stores: $stores,
          config: {file: (if $config_file == "" then null else $config_file end),
                   found: ($config_file != ""),
                   warnings: $config_warnings},
          serving: {url: $url,
                    port: $port,
                    ok: ($http_code != null),
                    http_code: $http_code,
                    holder_pid: $holder_pid,
                    holder_is_hud_server: $holder_is_hud},
          service: {label: $service_label,
                    available: $service_available,
                    loaded: $service_loaded,
                    pid: $service_pid,
                    plist: $plist,
                    plist_present: $plist_present},
          log: $log,
          cli_link: {dir: $link_dir,
                     path: $link_path,
                     target: (if $link_target == "" then null else $link_target end),
                     linked: $link_linked,
                     dir_on_path: $link_on_path},
          backup: $backup,
          upstreams: $upstreams}'
}

cmd_status() {
    local as_json=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) as_json=yes; shift ;;
            *) die "status: unknown argument $1" ;;
        esac
    done

    load_config
    probe_upstreams
    probe_backup

    local holder code health service_state pid
    holder="$(port_holder)"
    code="$(http_code "$URL")"
    if [[ -z "$code" || "$code" == "000" ]]; then health="not serving"; else health="HTTP $code"; fi

    # An unreachable upstream is a normal state, so JSON mode reports it and
    # exits 0 exactly as the human view does. The format changed; what the
    # command ASSERTS did not.
    if [[ -n "$as_json" ]]; then
        emit_status_json "$holder" "$code" "$(service_pid)"
        return 0
    fi

    pid="$(service_pid)"
    if service_loaded; then
        service_state="loaded, pid ${pid:-unknown}"
    elif have_launchd && [[ -f "$PLIST" ]]; then
        service_state="installed but not loaded — 'hud start' reloads it"
    elif have_launchd; then
        service_state="not installed — 'hud install' adds one (optional)"
    else
        service_state="n/a (launchd is macOS-only)"
    fi

    printf 'hud\n'
    printf '  root      %s\n' "$HUD_ROOT_R"
    printf '  config    %s\n' "${CFG_FILE:-none (defaults)}"
    printf '  serving   %-38s %s\n' "$URL" "$health"
    # The pid line only earns its place when it says something the service line
    # does not: a squatter, or a server running outside the service.
    if [[ -n "$holder" ]] && ! is_hud_server "$holder"; then
        printf '  port      held by pid %s, which is not a HUD server\n' "$holder"
    elif [[ -n "$holder" && "$holder" != "$pid" ]]; then
        printf '  pid       %s (server.mjs, not under launchd)\n' "$holder"
    fi
    printf '  service   %-38s %s\n' "$LABEL" "$service_state"
    printf '  log       %s\n' "$LOG_FILE"
    report_backup
    for warn in ${CONFIG_WARNS[@]+"${CONFIG_WARNS[@]}"}; do
        printf '  config!   %s\n' "$warn"
    done

    # Stores are printed only when there are some, or something was refused:
    # a single-store machine is the common case and does not need a heading.
    if [[ ${#READ_STORES[@]} -gt 0 || ${#READ_WARNS[@]} -gt 0 ]]; then
        printf '\nstores\n'
        printf '  %-9s %-10s %s\n' 'local' 'writable' "$HUD_ROOT_R"
        local entry
        for entry in ${READ_STORES[@]+"${READ_STORES[@]}"}; do
            printf '  %-9s %-10s %s\n' "${entry%% *}" 'read-only' "${entry#* }"
        done
        for entry in ${READ_WARNS[@]+"${READ_WARNS[@]}"}; do
            printf '  %-9s %-10s %s\n' '!' 'ignored' "$entry"
        done
        printf '\nOnly the writable store is pushed by '"'"'hud sync'"'"'. A read-only store is\n'
        printf 'on this machine because it was cloned here; nothing here enforces that.\n'
    fi

    printf '\nupstreams\n'
    report_upstreams

    printf '\nAn unreachable upstream is a normal state: the HUD greys that panel out\n'
    printf 'and keeps serving everything else, so this command still exits 0.\n'
    return 0
}

cmd_open() {
    load_config
    if command -v open >/dev/null 2>&1; then
        open "$URL"
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$URL"
    else
        die "no opener found — browse $URL yourself."
    fi
}

cmd_logs() {
    load_config
    [[ -f "$LOG_FILE" ]] || die "no log yet at $LOG_FILE"
    local follow="" lines=40
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f | --follow) follow="-f"; shift ;;
            -n) lines="$2"; shift 2 ;;
            *) die "logs: unknown argument $1" ;;
        esac
    done
    # Both start paths write here: the plist names this file, and the
    # backgrounded fallback appends to it, so `hud logs` is correct either way.
    tail ${follow:+"$follow"} -n "$lines" -- "$LOG_FILE"
}

# ------------------------------------------------------------------ sync
#
# One verb for "back my notes up", because the tree is edited constantly — by
# you, by the hud skill, by whatever agent was told to write a note — and the
# only thing standing between all of that and a dead laptop was remembering to
# run three git commands. Three commands you remember is not a backup.
#
# Nothing here is a new idea about git; it is `add`, `commit`, `push` with the
# three answers that a wrapper has to get right pre-decided:
#   - a clean tree is NOT an error. `hud sync` on an already-synced tree says so
#     and exits 0, so it is safe to run reflexively, in a loop, from a hook.
#   - it never force-pushes, and never offers to. A diverged remote means some
#     other machine wrote here, and the only safe answer is a human pulling.
#   - it refuses before it touches anything, so the operation is atomic: either
#     the tree is staged, committed and pushed, or nothing happened at all.
#     Half-syncs are the state that makes people distrust the verb.

# What `git add` would pick up, as (status, path) pairs. Read with -z and
# --untracked-files=all so the dry-run can name FILES rather than the collapsed
# `newdir/` that porcelain prints by default: "would stage inbox/" is not an
# answer to "what exactly are you about to commit".
SYNC_XY=() SYNC_PATH=()
sync_collect() {
    SYNC_XY=() SYNC_PATH=()
    local rec
    while IFS= read -r -d '' rec; do
        SYNC_XY+=("${rec:0:2}")
        SYNC_PATH+=("${rec:3}")
        # In -z mode a rename/copy is two NUL-terminated fields, `to` then
        # `from`, with no ` -> ` between them. Consume the second or the next
        # iteration reads a path as if it were a status code.
        case "${rec:0:2}" in
            R* | C*) IFS= read -r -d '' _ || true ;;
        esac
    done < <(git_tree status --porcelain --untracked-files=all -z -- . || true)
}

# A message that says what changed without pretending to know why. One file
# gets named; several get counted and attributed to the sections they came
# from, which is the level of detail `git log --oneline` in the tree is
# actually read at. -m overrides it whenever the why is worth writing down.
sync_message() {
    local n=${#SYNC_PATH[@]}
    (( n > 0 )) || return 0
    if (( n == 1 )); then
        printf 'hud sync: %s\n' "${SYNC_PATH[0]}"
        return 0
    fi
    local p sec s seen secs=() joined=""
    for p in "${SYNC_PATH[@]}"; do
        if [[ "$p" == */* ]]; then sec="${p%%/*}"; else sec="top level"; fi
        seen=""
        for s in ${secs[@]+"${secs[@]}"}; do
            [[ "$s" == "$sec" ]] && { seen=yes; break; }
        done
        [[ -n "$seen" ]] || secs+=("$sec")
    done
    for s in "${secs[@]}"; do
        joined="${joined:+$joined, }$s"
    done
    printf 'hud sync: %d files (%s)\n' "$n" "$joined"
}

# Would the push fast-forward? Answered with ls-remote, which reads the remote's
# ref and writes nothing locally — the property that lets --dry-run be genuinely
# inert. A `git fetch` would answer the same question but move remote-tracking
# refs to do it, and a --dry-run that edits .git/ is not one.
#
# Sets SYNC_FF to exactly one of: ff | new | diverged | unreachable, and
# SYNC_REMOTE_TIP to the remote's commit when there is one. It assigns rather
# than echoes because a `$(...)` caller would run it in a subshell and throw
# SYNC_REMOTE_TIP away — which reads as "the remote is at nothing", i.e. as an
# already-synced tree needing a push.
SYNC_FF="" SYNC_REMOTE_TIP=""
push_ff_state() {
    SYNC_FF="" SYNC_REMOTE_TIP=""
    local out tip head
    if ! out="$(git_tree ls-remote --heads "$BACKUP_REMOTE" \
            "refs/heads/$BACKUP_BRANCH" 2>/dev/null)"; then
        SYNC_FF=unreachable
        return 0
    fi
    tip="$(awk 'NR == 1 { print $1 }' <<<"$out")"
    if [[ -z "$tip" ]]; then
        # The branch does not exist there yet. The first push creates it, which
        # can never be a non-fast-forward.
        SYNC_FF=new
        return 0
    fi
    SYNC_REMOTE_TIP="$tip"
    head="$(git_tree rev-parse --verify --quiet HEAD 2>/dev/null || true)"
    # No commits here at all, but commits there: pulling is the only way to
    # reconcile that, so it is the same refusal as any other divergence.
    [[ -n "$head" ]] || { SYNC_FF=diverged; return 0; }
    # Having the object is a precondition for the ancestry test; not having it
    # means the remote moved somewhere we have never seen.
    if ! git_tree cat-file -e "${tip}^{commit}" 2>/dev/null; then
        SYNC_FF=diverged
        return 0
    fi
    if git_tree merge-base --is-ancestor "$tip" HEAD; then
        SYNC_FF=ff
    else
        SYNC_FF=diverged
    fi
}

cmd_sync() {
    local dry="" message="" have_message=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m | --message)
                [[ $# -ge 2 ]] || die "sync: $1 needs a message"
                message="$2"; have_message=yes; shift 2 ;;
            --message=*) message="${1#--message=}"; have_message=yes; shift ;;
            -n | --dry-run) dry=yes; shift ;;
            *) die "sync: unknown argument $1" ;;
        esac
    done
    [[ -z "$have_message" || -n "$message" ]] || die "sync: -m was given an empty message"

    load_config
    command -v git >/dev/null 2>&1 || die "no 'git' on PATH — 'hud sync' needs it."
    git_tree rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "$HUD_ROOT_R is not a git repository.

Backing the tree up starts with making it one:

    git -C $HUD_ROOT_R init
    git -C $HUD_ROOT_R remote add origin <url>"

    probe_backup
    if [[ "$BACKUP_STATUS" == absent || -z "$BACKUP_REMOTE" ]]; then
        die "$HUD_ROOT_R has no git remote, so there is nowhere to back it up.

    git -C $HUD_ROOT_R remote add origin <url>
    hud sync

Use a PRIVATE remote: this tree is your notes, not the machinery."
    fi
    [[ -n "$BACKUP_BRANCH" ]] \
        || die "HEAD is detached in $HUD_ROOT_R — check out a branch first."

    sync_collect
    local nchanges=${#SYNC_PATH[@]}

    # Assert the thing the whole split depends on, rather than trusting it.
    # `git add -A` does honour .gitignore, and porcelain does omit ignored
    # paths — so this can only ever fire if one of those stopped being true, or
    # if a path was force-added into the index earlier. Either way it must stop
    # the sync: .generated/ holds the service log and the peers snapshot, and
    # the _hud symlink names a path that exists on exactly one machine.
    if (( nchanges > 0 )); then
        local leaked
        leaked="$(printf '%s\0' "${SYNC_PATH[@]}" \
            | git_tree check-ignore --stdin -z 2>/dev/null | tr '\0' ' ' || true)"
        if [[ -n "${leaked// /}" ]]; then
            die "refusing to sync: these are gitignored and must not be committed:
  $leaked
Nothing was staged."
        fi
    fi

    push_ff_state
    local head; head="$(git_tree rev-parse --verify --quiet HEAD 2>/dev/null || true)"

    # Refuse first, and refuse having done nothing. Committing and then failing
    # to push would leave the tree in a state whose repair depends on what the
    # verb got through, and the notes are still on disk either way — so
    # atomicity is worth more here than a salvaged local commit.
    if [[ "$SYNC_FF" == diverged ]]; then
        printf 'hud: %s/%s holds commits this tree does not — refusing to sync.\n\n' \
            "$BACKUP_REMOTE" "$BACKUP_BRANCH" >&2
        printf '    git -C %s pull --rebase\n    hud sync\n\n' "$HUD_ROOT_R" >&2
        printf 'Nothing was staged, committed, or pushed. A force-push would make\n' >&2
        printf 'the other side of that divergence — another machine, or an agent —\n' >&2
        printf 'unrecoverable, so this command does not offer one.\n' >&2
        exit 1
    fi

    # Whether the remote is missing commits we already have. `unreachable` means
    # we could not ask, so fall back to the local remote-tracking ref and let
    # the push itself be the authority.
    local need_push=""
    case "$SYNC_FF" in
        new) need_push=yes ;;
        ff) [[ "$SYNC_REMOTE_TIP" == "$head" ]] || need_push=yes ;;
        unreachable) (( ${BACKUP_AHEAD:-0} > 0 )) && need_push=yes ;;
    esac

    if (( nchanges == 0 )) && [[ -z "$need_push" ]]; then
        printf 'nothing to sync — %s is clean and in sync with %s/%s\n' \
            "$HUD_ROOT_R" "$BACKUP_REMOTE" "$BACKUP_BRANCH"
        return 0
    fi

    [[ -n "$have_message" ]] || message="$(sync_message)"

    if [[ -n "$dry" ]]; then
        printf 'hud sync --dry-run — none of the following was done.\n\n'
        if (( nchanges > 0 )); then
            printf 'would stage (%d):\n' "$nchanges"
            local i
            for i in "${!SYNC_PATH[@]}"; do
                printf '  %-2s %s\n' "${SYNC_XY[$i]}" "${SYNC_PATH[$i]}"
            done
            printf '\nwould commit:\n  %s\n' "$message"
        else
            printf 'would stage: nothing — no uncommitted changes\n'
        fi
        printf '\nwould push: %s -> %s/%s' "${BACKUP_BRANCH}" "$BACKUP_REMOTE" "$BACKUP_BRANCH"
        [[ -n "$BACKUP_URL" ]] && printf ' (%s)' "$BACKUP_URL"
        printf '\n'
        case "$SYNC_FF" in
            new) printf '  the branch does not exist there yet — the push creates it\n' ;;
            unreachable) printf '  could not reach %s to check — the real push may still fail\n' \
                "$BACKUP_REMOTE" ;;
        esac
        printf '\nGitignored paths are never staged, so nothing under .generated/ and\n'
        printf 'no _hud symlink appears above. Run without --dry-run to do it.\n'
        return 0
    fi

    if (( nchanges > 0 )); then
        git_tree add -A -- .
        git_tree commit -q -m "$message"
        printf 'committed %d file(s): %s\n' "$nchanges" "$message"
    fi

    # No --force, no --force-with-lease, no prompt offering either. -u only when
    # there is no upstream yet, so the ordinary case does not rewrite config.
    local push_args=("$BACKUP_REMOTE" "$BACKUP_BRANCH")
    [[ -n "$BACKUP_UPSTREAM" ]] || push_args=(--set-upstream "${push_args[@]}")
    if ! git_tree push "${push_args[@]}"; then
        printf '\nhud: the push failed. Your notes are committed locally and nothing\n' >&2
        printf 'was forced. If the remote moved while this ran:\n\n' >&2
        printf '    git -C %s pull --rebase\n    hud sync\n' "$HUD_ROOT_R" >&2
        exit 1
    fi
    probe_backup
    printf 'synced %s -> %s/%s (%s)\n' \
        "$HUD_ROOT_R" "$BACKUP_REMOTE" "$BACKUP_BRANCH" "$BACKUP_STATUS"
}

# Where the `hud` COMMAND goes — as opposed to `install`, which is the launchd
# service and touches nothing on your PATH.
#
# This is the one thing in this script that is a per-user concern rather than a
# per-tree one, which is why it is the one thing that consults XDG:
# $XDG_BIN_HOME if set, else ~/.local/bin. XDG does not actually define a
# variable for user binaries — ~/.local/bin is convention, not spec — so
# nothing here invents one to go with it. HUD_LINK_DIR remains the explicit
# override for installing somewhere else once.
link_target_dir() {
    printf '%s\n' "${HUD_LINK_DIR:-${XDG_BIN_HOME:-$HOME/.local/bin}}"
}

# Not being on PATH is a warning, not a failure: the link is correctly made,
# and whether your shell can find it is a fact about your rc file — which this
# script does not edit, so it prints the line for you to paste instead.
warn_if_not_on_path() {
    case ":${PATH}:" in
        *":$1:"*) return 0 ;;
    esac
    printf '\n%s is not on your PATH. Add this to your shell rc:\n\n' "$1" >&2
    # shellcheck disable=SC2016  # $PATH is literal: this is a line to paste
    printf '    export PATH="%s:$PATH"\n' "$1" >&2
}

cmd_link() {
    local dir dest current
    dir="$(link_target_dir)"
    dest="$dir/hud"

    if [[ -e "$dest" && ! -L "$dest" ]]; then
        die "$dest exists and is not a symlink — move it yourself."
    fi
    if [[ -L "$dest" ]]; then
        current="$(resolve_path "$dest")"
        if [[ "$current" == "$SELF_ABS" ]]; then
            printf 'already linked: %s -> %s\n' "$dest" "$SELF_ABS"
            warn_if_not_on_path "$dir"
            return 0
        fi
        # Another install, or an older checkout of this one. Overwriting it is
        # how you find out, much later and from a confusing symptom, that `hud`
        # stopped being the hud you thought it was.
        printf 'hud: %s is a link to somewhere else — not replacing it:\n' "$dest" >&2
        printf '  existing  %s\n' "$current" >&2
        printf '  this one  %s\n' "$SELF_ABS" >&2
        printf "\nRun 'hud unlink' from the checkout that owns it, remove it yourself,\n" >&2
        printf 'or set HUD_LINK_DIR to install this one somewhere else.\n' >&2
        exit 1
    fi

    mkdir -p -- "$dir"
    ln -sfn -- "$SELF_ABS" "$dest"
    printf 'linked %s -> %s\n' "$dest" "$SELF_ABS"
    warn_if_not_on_path "$dir"
}

cmd_unlink() {
    local dir dest current
    dir="$(link_target_dir)"
    dest="$dir/hud"

    # -e is false for a dangling symlink, so both tests are needed to tell
    # "nothing here" from "a link to something that is gone".
    if [[ ! -e "$dest" && ! -L "$dest" ]]; then
        printf 'nothing to unlink: %s does not exist\n' "$dest"
        return 0
    fi
    if [[ ! -L "$dest" ]]; then
        die "$dest is not a symlink — this command did not put it there."
    fi
    current="$(resolve_path "$dest")"
    if [[ "$current" != "$SELF_ABS" ]]; then
        printf 'hud: %s points at another install — leaving it alone:\n' "$dest" >&2
        printf '  existing  %s\n' "$current" >&2
        printf '  this one  %s\n' "$SELF_ABS" >&2
        exit 1
    fi
    rm -- "$dest"
    printf 'unlinked %s\n' "$dest"
}

# ------------------------------------------------------------------- init
#
# The command a new user runs first, and the only one in this script that
# creates a content tree rather than talking to one that already exists.
#
# Its whole design is one idea: DETECT, DO NOT ASSUME. A generated config that
# simply listed the sources the author happens to run would hand a new user a
# HUD with four grey panels and no way to tell broken from not-configured —
# which is the worst first impression this tool can make, because every other
# explanation lives in a file they have not read yet. So init probes for each
# source and writes a live entry only for what is actually there; everything it
# could not find goes into the same file as a commented stub carrying the
# reason it was skipped and the one thing to install to enable it. The
# explanation for a grey panel sits next to that panel's own config, which is
# the only place the user is guaranteed to look.
#
# The probes are the ones `hud status` already uses — `http_answers`, `cmd_head`
# plus `command -v`, and a directory test — asked of candidate endpoints rather
# than configured ones. A second opinion about what "reachable" means is how you
# get a config that init calls good and status calls dead.
#
# Four things it deliberately does not do:
#   - it never overwrites an existing hud.toml. It prints what it would have
#     written, and a diff against what is there when `diff` is available;
#   - it never clobbers any existing scaffold file — it adds only what is
#     genuinely missing, and says `keep` for the rest;
#   - it never creates a git remote. That is outward-facing and the user's
#     decision, so it prints the command and stops;
#   - `--dry-run` writes nothing at all, not even the root directory.

# Candidate endpoints and commands — the things init PROBES for. They are
# defaults to test, never values to assume: one that does not answer is written
# out commented, with the reason, and is not configured. This is also the only
# place in this script that names a candidate port or CLI, so there is one line
# to change when a default moves.
INIT_BOARD_URL="http://127.0.0.1:8787/api/board"
INIT_DIGEST_CMD="lectio digest --since 24h"
# The tilde is deliberately NOT expanded here: this string is written into
# hud.toml, where the server's own expandHome() handles a leading `~`. Writing
# an expanded absolute path would put this user's home directory into a file
# that is meant to be safe to check in.
# shellcheck disable=SC2088
INIT_SESSIONS_ROOT="~/.claude"
INIT_LECTIO_URL="http://127.0.0.1:7533"
# RFC 2606 reserves `.invalid`, and the UI treats this exact placeholder the
# same as unconfigured: ticket ids render as plain chips until a real tracker
# replaces it. So the default is safe to ship and obvious to spot.
INIT_TICKET_TEMPLATE="https://example.invalid/issue/{id}"

INIT_ROOT="" INIT_YES="" INIT_DRY=""
INIT_TICKET="" INIT_DO_LINK="" INIT_DO_INSTALL=""

# Detection results, one row per source: name, state, what was probed, why, and
# the fix. Same shape as the upstream table `status` keeps, for the same reason
# — the plan output and the config renderer read from one set of facts, so the
# file cannot claim something the report did not.
DET_NAMES=() DET_STATES=() DET_TARGETS=() DET_REASONS=() DET_FIXES=()

det() {
    DET_NAMES+=("$1"); DET_STATES+=("$2"); DET_TARGETS+=("$3")
    DET_REASONS+=("$4"); DET_FIXES+=("$5")
}

# det_get <name> <state|target|reason|fix>
det_get() {
    local i
    for i in ${DET_NAMES[@]+"${!DET_NAMES[@]}"}; do
        [[ "${DET_NAMES[$i]}" == "$1" ]] || continue
        case "$2" in
            state) printf '%s\n' "${DET_STATES[$i]}" ;;
            target) printf '%s\n' "${DET_TARGETS[$i]}" ;;
            reason) printf '%s\n' "${DET_REASONS[$i]}" ;;
            fix) printf '%s\n' "${DET_FIXES[$i]}" ;;
        esac
        return 0
    done
}

det_is() { [[ "$(det_get "$1" state)" == "$2" ]]; }

detect_sources() {
    DET_NAMES=() DET_STATES=() DET_TARGETS=() DET_REASONS=() DET_FIXES=()
    local rc

    rc=0; http_answers "$INIT_BOARD_URL" || rc=$?
    case "$rc" in
        0) det board present "$INIT_BOARD_URL" \
            "answered HTTP $HTTP_ANSWER_CODE" "" ;;
        2) det board skipped "$INIT_BOARD_URL" \
            "curl not found — could not probe" \
            "install curl, then set url yourself if a board is running" ;;
        *) det board absent "$INIT_BOARD_URL" \
            "nothing answered there" \
            "start your work-board service, or point url at wherever it serves" ;;
    esac

    local digest_bin
    digest_bin="$(cmd_head "$INIT_DIGEST_CMD")"
    if command -v "$digest_bin" >/dev/null 2>&1; then
        det digest present "$INIT_DIGEST_CMD" "$digest_bin is on PATH" ""
    else
        det digest absent "$INIT_DIGEST_CMD" "$digest_bin is not on PATH" \
            "install the $digest_bin CLI, or set cmd to anything that prints the digest JSON on stdout"
    fi

    local sroot="${INIT_SESSIONS_ROOT/#\~/$HOME}"
    if [[ -d "$sroot" ]]; then
        det sessions present "$INIT_SESSIONS_ROOT" "the directory exists" ""
    else
        det sessions absent "$INIT_SESSIONS_ROOT" "no such directory" \
            "point root at wherever your agent sessions are written"
    fi

    rc=0; http_answers "$INIT_LECTIO_URL" || rc=$?
    case "$rc" in
        0) det graft present "$INIT_LECTIO_URL" \
            "answered HTTP $HTTP_ANSWER_CODE" "" ;;
        2) det graft skipped "$INIT_LECTIO_URL" \
            "curl not found — could not probe" \
            "install curl, then set lectio yourself if the daemon is running" ;;
        *) det graft absent "$INIT_LECTIO_URL" \
            "nothing answered there" \
            "start the lectio daemon; sessions still work without it, ungrafted" ;;
    esac

    # peers is the one source with no config key at all: handles come from
    # `peers/*.md`, and the lookup shells out to `gh`. So both halves have to be
    # true, and neither is something a config line can express — which is
    # exactly why init reports it and writes a comment rather than a stub.
    if ! command -v gh >/dev/null 2>&1; then
        det peers absent gh "the gh CLI is not on PATH" \
            "install gh, run 'gh auth login', then add one file per colleague under peers/"
    elif gh auth status >/dev/null 2>&1; then
        det peers present gh "gh is on PATH and authenticated" \
            "add one file per colleague under peers/ to populate the panel"
    else
        det peers absent gh "gh is on PATH but not authenticated" \
            "run 'gh auth login', then add one file per colleague under peers/"
    fi

    # loadout reads the local filesystem and calls nothing, so there is nothing
    # to detect and nothing to configure: it is on unless switched off.
    det loadout present "(local filesystem)" "needs no endpoint — on by default" ""
}

report_detection() {
    local i state
    for i in ${DET_NAMES[@]+"${!DET_NAMES[@]}"}; do
        case "${DET_STATES[$i]}" in
            present) state="configured" ;;
            absent) state="stub" ;;
            *) state="${DET_STATES[$i]}" ;;
        esac
        printf '  %-9s %-10s %-34s %s\n' \
            "${DET_NAMES[$i]}" "$state" "${DET_TARGETS[$i]}" "${DET_REASONS[$i]}"
    done
}

# ------------------------------------------------------------------ pull

# Bring read-only stores up to date. The mirror image of `sync`: sync pushes
# the ONE store this machine owns and never reads others; pull reads the others
# and never touches the writable one. Neither verb can reach the other's store,
# which is what keeps write-1:1 true by construction rather than by care.
#
# Fast-forward only, and never on a dirty tree. A mounted store is not yours to
# reconcile: if it has diverged or carries local work, saying so and doing
# nothing is the useful outcome.
#
# Four outcomes, closed: updated | current | skipped | refused. `skipped` is a
# store that cannot participate (no remote, no upstream, not a repo) and is a
# normal state; `refused` is one that could have and should not, and is the
# only outcome that makes this command exit non-zero.
cmd_pull() {
    local dry=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n | --dry-run) dry=yes; shift ;;
            *) die "pull: unknown argument $1" ;;
        esac
    done

    load_config
    command -v git >/dev/null 2>&1 || die "no 'git' on PATH — 'hud pull' needs it."

    if [[ ${#READ_STORES[@]} -eq 0 ]]; then
        printf 'no read-only stores configured — nothing to pull.\n\n'
        printf 'Add one in %s:\n\n    [read.<name>]\n    path = "~/stores/<name>"\n' \
            "${CFG_FILE:-hud.toml}"
        return 0
    fi

    local entry name p refused=0 branch remote head want
    for entry in ${READ_STORES[@]+"${READ_STORES[@]}"}; do
        name="${entry%% *}"
        p="${entry#* }"

        if ! git -C "$p" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            pull_say "$name" skipped "not a git repository"
            continue
        fi
        branch="$(git -C "$p" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
        if [[ -z "$branch" ]]; then
            pull_say "$name" skipped "HEAD is detached"
            continue
        fi
        remote="$(git -C "$p" config --get "branch.$branch.remote" 2>/dev/null || true)"
        if [[ -z "$remote" ]]; then
            pull_say "$name" skipped "no upstream for $branch"
            continue
        fi
        # Dirty first: refusing before touching the network keeps a store with
        # local edits completely untouched, including its .git.
        if [[ -n "$(git -C "$p" status --porcelain 2>/dev/null)" ]]; then
            pull_say "$name" refused "uncommitted changes — resolve them in $p first"
            refused=1
            continue
        fi

        head="$(git -C "$p" rev-parse HEAD 2>/dev/null || true)"

        if [[ -n "$dry" ]]; then
            # ls-remote, not fetch: --dry-run must not write even to .git.
            want="$(git -C "$p" ls-remote "$remote" "refs/heads/$branch" 2>/dev/null | awk '{print $1}')"
            if [[ -z "$want" ]]; then
                pull_say "$name" skipped "$remote has no $branch"
            elif [[ "$want" == "$head" ]]; then
                pull_say "$name" current "$branch matches $remote (as of this probe)"
            else
                pull_say "$name" updated "would fast-forward $branch toward ${want:0:8} (dry run)"
            fi
            continue
        fi

        if ! git -C "$p" fetch --quiet "$remote" "$branch" 2>/dev/null; then
            pull_say "$name" skipped "could not reach $remote"
            continue
        fi
        want="$(git -C "$p" rev-parse FETCH_HEAD 2>/dev/null || true)"
        if [[ -z "$want" ]]; then
            pull_say "$name" skipped "$remote has no $branch"
        elif [[ "$want" == "$head" ]]; then
            pull_say "$name" current "$branch matches $remote"
        elif git -C "$p" merge-base --is-ancestor "$head" "$want" 2>/dev/null; then
            if git -C "$p" merge --ff-only "$want" >/dev/null 2>&1; then
                pull_say "$name" updated "$branch fast-forwarded to ${want:0:8}"
            else
                pull_say "$name" refused "fast-forward failed — reconcile $p by hand"
                refused=1
            fi
        elif git -C "$p" merge-base --is-ancestor "$want" "$head" 2>/dev/null; then
            pull_say "$name" refused "local commits are not on $remote — this store is read-only here"
            refused=1
        else
            pull_say "$name" refused "$branch has diverged from $remote — reconcile $p by hand"
            refused=1
        fi
    done

    printf '\nThe writable store is untouched: '"'"'hud pull'"'"' never reads it and\n'
    printf "'hud sync' never reads these. Only a 'refused' row needs you.\n"
    return "$refused"
}

pull_say() { printf '  %-9s %-9s %s\n' "$1" "$2" "$3"; }

# ------------------------------------------------------------ init prompts

# One prompt, one default. Non-interactive — `--yes`, `--dry-run`, or a
# non-TTY stdin — takes the default without asking, so the same invocation can
# be scripted. Reads from /dev/tty rather than stdin so init still prompts when
# its stdin is a pipe but a terminal is attached; `read -p` writes the prompt to
# stderr, which keeps it out of the captured answer.
ask() {
    local prompt="$1" def="$2" ans=""
    if [[ -n "$INIT_YES" || -n "$INIT_DRY" || ! -t 0 ]]; then
        printf '%s\n' "$def"
        return 0
    fi
    read -r -p "  $prompt [$def]: " ans </dev/tty || ans=""
    printf '%s\n' "${ans:-$def}"
}

ask_yn() {
    local ans
    ans="$(ask "$1 (y/n)" "$2")"
    case "$ans" in [Yy]*) printf 'yes\n' ;; *) printf 'no\n' ;; esac
}

# --------------------------------------------------------- init templates
#
# Generated from templates here, never copied from an existing tree: a copy
# would carry one person's content conventions, their project names, and
# whatever had drifted in their file, none of which is the contract.

tmpl_gitignore() {
    cat <<'EOF'
.generated/
_hud
EOF
}

tmpl_index_md() {
    cat <<'EOF'
# index

One line per entry: a link to the file plus a one-line summary. Agents append
here after any write to the tree (see the ingest workflow in `HUD.md`). This
file is a catalog, not a duplicate of content — read it first, then load
individual pages selectively.

<!-- entries below, newest last -->
EOF
}

tmpl_log_md() {
    cat <<'EOF'
# log

Append-only record of ingests, lint passes, and migrations. Agents append one
dated entry per action; never edit or remove prior entries.

EOF
    printf '## %s\n\n' "$(date -u '+%Y-%m-%d')"
    cat <<'EOF'
- Scaffolded this tree with `hud init`: `HUD.md`, `index.md`, `log.md`,
  `hud.toml`, `.gitignore`, the `_hud` symlink, and the content directories.
  Sources were detected rather than assumed — `hud.toml` records which were
  found and which were left commented out, and why.
EOF
}

# The schema file every tree gets. NOT a heredoc: it is generated from
# hud-contract.mjs into templates/HUD.md, because the six kinds, the
# frontmatter vocabulary and the path conventions it states are the same
# declaration the write path and the doc generator read. A copy of that
# contract here is the copy that SHIPS — drift in a repo file is a pull
# request, drift in a scaffolded tree is already on someone's disk.
#
# `hud docgen --check` fails when the committed template no longer matches,
# and test/docgen.test.mjs runs that check, so this file cannot go stale
# quietly.
tmpl_hud_md() {
    local tmpl="$MACHINERY_DIR/templates/HUD.md"
    [[ -f "$tmpl" ]] || die "missing $tmpl — run 'hud docgen --write'"
    cat -- "$tmpl"
}

# The generated config. Detected sources become live tables; the rest become
# commented stubs with their reason and their fix on the lines above, because
# the config file is where someone looks when a panel is not there.
tmpl_toml() {
    cat <<'EOF'
# hud.toml — the HUD's only config. Hand-edit this file; nothing regenerates it.
#
# `hud init` wrote this from what was actually running on this machine at the
# time (see the date at the bottom). Every source below is either a live entry
# — init found the tool or the service — or a COMMENTED STUB carrying the
# reason it was skipped and what to install to enable it. Uncomment a stub once
# you have the thing it names; a panel whose source is absent is a panel that
# does not exist, so there is nothing else to switch on.
#
# It holds localhost endpoints, commands, and defaults — never a name, handle,
# or URL that identifies a person, company, or project. Those live in the tree
# as content, which is what keeps this file safe to check in.
#
# The subset the parser reads: [tables], `key = "string"`, `key = 123`,
# `key = true`, and `#` comments. A line outside that is skipped with a warning
# printed at startup, so a typo costs you one key, not the whole config.
#
# Every key, and what each panel does when its source is absent:
# `_hud/docs/SOURCES.md`.

# ------------------------------------------------------------- top level
#
# This comes first on purpose: in TOML every key after a [table] header belongs
# to that table, so a top-level key written at the bottom of the file would
# quietly become `serve.whatever`.

# Ticket ids in frontmatter render as links through this template, with `{id}`
# substituted. The default points at a reserved documentation domain
# (RFC 2606), which the UI treats the same as unconfigured: ids stay plain
# chips until you put a real tracker here.
EOF
    printf 'ticket_url_template = "%s"\n' "$INIT_TICKET"

    cat <<'EOF'

# ---------------------------------------------------------------- sources
#
# The panel switchboard. A source present enables its panel; a source removed
# removes the panel. There is no other registration and no code change either
# way.

EOF

    # ---- board
    printf '# MY PRS and the needs-you dial: a local work-board service.\n'
    if det_is board present; then
        printf '[sources.board]\nurl = "%s"\n' "$(det_get board target)"
    else
        printf '# NOT CONFIGURED: %s.\n' "$(det_get board reason)"
        printf '# To enable: %s.\n# Then uncomment:\n' "$(det_get board fix)"
        printf '#   [sources.board]\n#   url = "%s"\n' "$(det_get board target)"
    fi

    # ---- digest
    printf '\n# RECENT ACTIVITY: a local digest CLI, run with no shell (argv only).\n'
    if det_is digest present; then
        printf '[sources.digest]\ncmd = "%s"\n' "$(det_get digest target)"
    else
        printf '# NOT CONFIGURED: %s.\n' "$(det_get digest reason)"
        printf '# To enable: %s.\n# Then uncomment:\n' "$(det_get digest fix)"
        printf '#   [sources.digest]\n#   cmd = "%s"\n' "$(det_get digest target)"
    fi

    # ---- sessions (+ the graft daemon, which is only useful with a root)
    cat <<'EOF'

# SESSIONS: your agent sessions on disk, grafted to commits, PRs and tickets
# when the lectio daemon answers. Remove `root` and the panel disappears;
# `lectio` is optional sugar on top of it.
EOF
    if det_is sessions present; then
        printf '[sources.sessions]\nroot = "%s"\n' "$(det_get sessions target)"
        if det_is graft present; then
            printf 'lectio = "%s"\n' "$(det_get graft target)"
        else
            printf '# lectio NOT CONFIGURED: %s.\n' "$(det_get graft reason)"
            printf '# To enable: %s.\n# Then uncomment:\n' "$(det_get graft fix)"
            printf '# lectio = "%s"\n' "$(det_get graft target)"
        fi
    else
        printf '# NOT CONFIGURED: %s at %s.\n' \
            "$(det_get sessions reason)" "$(det_get sessions target)"
        printf '# To enable: %s.\n# Then uncomment:\n' "$(det_get sessions fix)"
        printf '#   [sources.sessions]\n#   root = "%s"\n' "$(det_get sessions target)"
        printf '#   lectio = "%s"   # optional: %s\n' \
            "$(det_get graft target)" "$(det_get graft reason)"
    fi

    # ---- peers: no config key exists, so this section is comment only.
    cat <<'EOF'

# PEERS has no config key, and that is not an omission: handles come from
# `peers/*.md` frontmatter (`gh:`, defaulting to the filename), and the PR
# lookup shells out to an authenticated `gh`. Adding a colleague is adding a
# file.
EOF
    printf '# At init time: %s.\n' "$(det_get peers reason)"
    printf '# Next: %s.\n' "$(det_get peers fix)"

    # ---- loadout: on by default, so only the off switch is worth writing.
    printf '\n# LOADOUT reads the local filesystem and needs no endpoint, so it is on by\n'
    printf '# default — these lines only exist to turn it off or point it elsewhere.\n'
    printf '#   [sources]\n'
    printf '#   loadout = false            # switch the panel off entirely\n'
    printf '#   [sources.loadout]\n'
    printf '#   claude_root = "~/.claude"  # a non-default install to inspect\n'

    cat <<'EOF'

# ------------------------------------------------------------------ serve
#
# Read by the `hud` command and by _hud/service/install.sh, which pass the port
# to the server in the environment. HUD_PORT, HUD_HOST, HUD_LABEL and HUD_ROOT
# in the environment win over anything here.

EOF
    cat <<'EOF'
[serve]
# The server always binds loopback. This is the address the health check and
# the printed URL use, so changing it does not expose the HUD.
host = "127.0.0.1"
EOF
    printf 'port = %s\n' "${CFG_DEFAULT_PORT:-4870}"
    cat <<'EOF'
# launchd label, which is also the plist filename.
label = "local.hud"
# Printed by install.sh as /etc/hosts guidance and nothing else — the server
# binds `host` above and never this name. `.internal` is ICANN-reserved for
# exactly this private use; `.local` would collide with mDNS. Commented out
# because enabling it is a manual sudo step.
# hostname = "hud.internal"
EOF
    # shellcheck disable=SC2016  # markdown ticks, not an expansion
    printf '\n# Written by `hud init` on %s.\n' "$(date -u '+%Y-%m-%d')"
}

# ------------------------------------------------------------ init actions

# install_file <relpath> <generator>. Existing files are kept and said so:
# "add what is missing" is the only write init does to a tree it did not make,
# and the difference between that and "reinitialize" is someone's notes.
install_file() {
    local rel="$1" fn="$2"
    local abs="$INIT_ROOT/$rel"
    if [[ -e "$abs" ]]; then
        printf '  keep    %s (already there)\n' "$rel"
        return 0
    fi
    printf '  create  %s\n' "$rel"
    [[ -n "$INIT_DRY" ]] && return 0
    mkdir -p -- "$(dirname -- "$abs")"
    # Rendered to a temp file and moved into place, so a generator that dies
    # half-way leaves no file rather than a truncated one. "Adding only what is
    # missing" is decided by whether the file exists, and a 0-byte HUD.md that
    # exists is the one state that rule handles badly.
    "$fn" >"$abs.hud-init.tmp"
    mv -f -- "$abs.hud-init.tmp" "$abs"
}

install_dir() {
    local rel="$1" abs="$INIT_ROOT/$1"
    if [[ -d "$abs" ]]; then
        printf '  keep    %s/ (already there)\n' "$rel"
        return 0
    fi
    printf '  create  %s/\n' "$rel"
    [[ -n "$INIT_DRY" ]] && return 0
    mkdir -p -- "$abs"
    # An empty directory is not a git object, so a clone of this tree would come
    # back without its sections. The keepfile is dot-prefixed, which is the rule
    # the tree walker already skips by, so it never renders as an entry.
    : >"$abs/.gitkeep"
}

# The `_hud` symlink. Content-side name for the machinery, so HUD.md can say
# `_hud/docs/SOURCES.md` without knowing where anyone checked this out.
install_machinery_link() {
    local abs="$INIT_ROOT/_hud"
    if [[ -L "$abs" ]]; then
        printf '  keep    _hud -> %s\n' "$(resolve_path "$abs")"
        return 0
    fi
    if [[ -e "$abs" ]]; then
        printf '  keep    _hud (exists and is not a symlink — left alone)\n'
        return 0
    fi
    printf '  create  _hud -> %s\n' "$MACHINERY_DIR"
    [[ -n "$INIT_DRY" ]] && return 0
    ln -sfn -- "$MACHINERY_DIR" "$abs"
}

# hud.toml is the one file that is never overwritten, because it is the one file
# the user edits by hand. An existing one is reported and diffed against what
# init would have written, so the choice of what to merge stays theirs.
install_config() {
    local name="${CFG_NAME:-hud.toml}" abs
    abs="$INIT_ROOT/$name"
    if [[ ! -e "$abs" ]]; then
        printf '  create  %s\n' "$name"
        [[ -n "$INIT_DRY" ]] && return 0
        tmpl_toml >"$abs.hud-init.tmp"
        mv -f -- "$abs.hud-init.tmp" "$abs"
        return 0
    fi

    printf '  keep    %s (already there — NOT overwritten)\n' "$name"
    if command -v diff >/dev/null 2>&1; then
        # A diff is the point here, so "they differ" (exit 1) is the expected
        # status and must not take the command down with it. An EMPTY diff is
        # worth saying out loud rather than printing a header over nothing:
        # "no output" would read as "it did not look".
        local delta
        delta="$(diff -u --label "$name (yours)" --label "$name (init would write)" \
            "$abs" <(tmpl_toml) || true)"
        if [[ -z "$delta" ]]; then
            printf '          identical to what init would write right now\n'
        else
            printf '\nwhat init would have written, against what is there:\n\n%s\n' "$delta"
        fi
    else
        # shellcheck disable=SC2016  # markdown ticks, not an expansion
        printf '\nwhat init would have written (no `diff` on PATH to compare):\n\n'
        tmpl_toml
    fi
}

# git init, and nothing about a remote. A tree nested inside another repository
# is reported rather than initialized: a repo inside a repo is a trap, and which
# one wins is not init's call to make.
init_git() {
    if ! command -v git >/dev/null 2>&1; then
        printf '  git     not found — skipped; a tree with no repo cannot be backed up\n'
        return 0
    fi
    local top=""
    top="$(git -C "$INIT_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
    if [[ -n "$top" ]]; then
        if [[ "$(resolve_path "$top")" == "$(resolve_path "$INIT_ROOT")" ]]; then
            printf '  git     already a repository\n'
        else
            printf '  git     inside %s — not creating a nested repository\n' "$top"
        fi
        return 0
    fi
    printf '  git     init\n'
    [[ -n "$INIT_DRY" ]] && return 0
    git -C "$INIT_ROOT" init -q
    git -C "$INIT_ROOT" add -A >/dev/null 2>&1 || true
    # Explicitly UNSIGNED, overriding whatever is in the user's global config.
    # This is a local bookkeeping commit of template files in a private tree,
    # and on a machine configured for keyless signing — `commit.gpgsign = true`
    # with a sigstore-backed gpg.x509.program — signing it would make `hud init`
    # reach a public transparency log, and would open a browser for an OIDC
    # flow if no credential were cached. A scaffold command must not do either.
    # The user's own commits here sign however they have configured; only this
    # one is forced off.
    if git -C "$INIT_ROOT" \
        -c commit.gpgsign=false -c tag.gpgsign=false \
        commit -qm 'hud: scaffold content tree' >/dev/null 2>&1; then
        printf '  git     initial commit (unsigned — see init_git)\n'
    else
        printf '  git     nothing committed (no git identity configured?) — commit it yourself\n'
    fi
}

init_closing() {
    local sections_hint="${KNOWN_SECTIONS:-projects playbooks peers inbox archive}"
    printf '\nnext\n'
    if [[ "$INIT_ROOT" != "$HOME/hud" ]]; then
        printf '  # this tree is not the default ~/hud, so name it:\n'
        printf '  export HUD_ROOT=%s\n' "$INIT_ROOT"
    fi
    printf '  hud start                  serve it, then open the printed URL\n'
    printf '  hud status                 what it is wired to, and what is grey\n'
    [[ "$INIT_DO_LINK" == yes ]] || printf '  hud link                   put this command on your PATH\n'
    [[ "$INIT_DO_INSTALL" == yes ]] || printf '  hud install                keep it serving without you (launchd)\n'

    printf '\nbackup\n'
    printf '  This tree is private and has no git remote. init does not create one —\n'
    printf '  that is outward-facing and your decision. When you want it backed up:\n\n'
    printf '    gh repo create <name> --private --source %s \\\n' "$INIT_ROOT"
    printf '      --remote origin --push\n'
    printf '    hud sync                   stage, commit, push, from then on\n'

    printf '\nwhere things go\n'
    printf '  content    %s/{%s}\n' "$INIT_ROOT" "${sections_hint// /,}"
    printf '  contract   %s/HUD.md — what every agent reads\n' "$INIT_ROOT"
    printf '  sources    %s/docs/SOURCES.md — every key, what\n' "$MACHINERY_DIR"
    printf '             enables it, and what each panel does when it is absent\n'
}

cmd_init() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root) [[ $# -ge 2 ]] || die 'init --root needs a directory'
                    INIT_ROOT="$2"; shift 2 ;;
            --root=*) INIT_ROOT="${1#--root=}"; shift ;;
            --yes | -y) INIT_YES=yes; shift ;;
            --dry-run) INIT_DRY=yes; shift ;;
            -h | --help) usage 0 ;;
            *) die "init: unknown option $1" ;;
        esac
    done

    # Read the server's own constants — the config filename, the default port,
    # the section list — rather than restating them here, where they would drift.
    # HUD_ROOT is set for the probe so a --root that does not exist yet still
    # resolves to itself instead of to the default tree.
    HUD_ROOT="${INIT_ROOT:-${HUD_ROOT:-}}" load_config || true

    printf 'hud init\n'

    local default_root="${INIT_ROOT:-${HUD_ROOT:-$HOME/hud}}"
    INIT_ROOT="$(ask 'content tree root' "$default_root")"
    INIT_ROOT="${INIT_ROOT/#\~/$HOME}"
    [[ "$INIT_ROOT" == /* ]] || INIT_ROOT="$PWD/${INIT_ROOT#./}"
    INIT_ROOT="${INIT_ROOT%/}"

    # Three roots that would do real damage, all rejected before anything is
    # probed. The machinery directory is the load-bearing one: the whole design
    # is public code in one place and private notes in another, and a tree
    # rooted in the checkout collapses that distinction silently.
    [[ -n "$INIT_ROOT" && "$INIT_ROOT" != "/" ]] || die 'init: refusing to use / as a content tree'
    [[ "$INIT_ROOT" != "$HOME" ]] || die "init: refusing to use your home directory as a content tree"
    case "$INIT_ROOT/" in
        "$MACHINERY_DIR"/*) die "init: $INIT_ROOT is inside the machinery checkout — the content tree must live outside it" ;;
    esac

    INIT_TICKET="$(ask 'ticket url template ({id} is substituted)' "$INIT_TICKET_TEMPLATE")"
    INIT_DO_LINK="$(ask_yn 'put the hud command on your PATH' n)"
    INIT_DO_INSTALL="$(ask_yn 'install the launchd service' n)"

    printf '\ndetecting sources (probing, not assuming)\n'
    detect_sources
    report_detection

    # Named either way: interactively these are the answers given, and in the
    # non-interactive modes they are the questions that were not asked and the
    # defaults taken instead — which a dry run has to show, or it is not a
    # preview of what the real run would do.
    if [[ -n "$INIT_DRY" ]]; then
        printf '\nprompts it would ask (a dry run never asks — defaults shown)\n'
    elif [[ -n "$INIT_YES" || ! -t 0 ]]; then
        printf '\nprompts, defaulted (non-interactive)\n'
    else
        printf '\nanswers\n'
    fi
    printf '  %-28s %s\n' 'root' "$INIT_ROOT"
    printf '  %-28s %s\n' 'ticket_url_template' "$INIT_TICKET"
    printf '  %-28s %s\n' 'link the hud command' "$INIT_DO_LINK"
    printf '  %-28s %s\n' 'install the service' "$INIT_DO_INSTALL"

    printf '\nscaffold at %s\n' "$INIT_ROOT"
    if [[ -e "$INIT_ROOT" ]]; then
        printf '  (exists — adding only what is missing, clobbering nothing)\n'
    fi
    [[ -n "$INIT_DRY" ]] || mkdir -p -- "$INIT_ROOT"

    install_file HUD.md tmpl_hud_md
    install_file index.md tmpl_index_md
    install_file log.md tmpl_log_md
    install_file .gitignore tmpl_gitignore
    install_machinery_link

    local section
    for section in ${KNOWN_SECTIONS:-projects playbooks peers inbox archive}; do
        install_dir "$section"
    done

    install_config
    init_git

    if [[ -n "$INIT_DRY" ]]; then
        printf '\nthe config it would write:\n\n'
        tmpl_toml
        printf '\n--dry-run: nothing was written'
        [[ -e "$INIT_ROOT" ]] || printf ' (%s does not exist)' "$INIT_ROOT"
        printf '.\n'
        return 0
    fi

    if [[ "$INIT_DO_LINK" == yes ]]; then
        printf '\n'
        cmd_link
    fi
    if [[ "$INIT_DO_INSTALL" == yes ]]; then
        printf '\n'
        HUD_ROOT="$INIT_ROOT" bash "$MACHINERY_DIR/service/install.sh"
    fi

    init_closing
}

# --------------------------------------------------------------- dispatch

[[ $# -gt 0 ]] || usage 1
command="$1"
shift

case "$command" in
    init) cmd_init "$@" ;;
    # A dispatch, not an implementation — same shape as `index` below. The
    # authoring rules live in hud-contract.mjs and the verb in hud-new.mjs,
    # because the READ path has to consume those rules too and the shell is
    # not a place server.mjs can import from. --help is answered here so the
    # one usage text stays in one file.
    new) case "${1:-}" in -h | --help) usage 0 ;; esac
         exec node "$MACHINERY_DIR/hud-new.mjs" "$@" ;;
    docgen) exec node "$MACHINERY_DIR/hud-docgen.mjs" "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    restart) cmd_restart "$@" ;;
    status) cmd_status "$@" ;;
    open) cmd_open "$@" ;;
    logs) cmd_logs "$@" ;;
    root) load_config; printf '%s\n' "$HUD_ROOT_R" ;;
    sync) cmd_sync "$@" ;;
    pull) cmd_pull "$@" ;;
    link) cmd_link "$@" ;;
    unlink) cmd_unlink "$@" ;;
    install) exec bash "$MACHINERY_DIR/service/install.sh" "$@" ;;
    uninstall) exec bash "$MACHINERY_DIR/service/uninstall.sh" "$@" ;;
    index) exec node "$MACHINERY_DIR/hud-index.mjs" "$@" ;;
    smoke) exec bash "$MACHINERY_DIR/smoke.sh" "$@" ;;
    test) exec node --test "$MACHINERY_DIR/test/" "$@" ;;
    help | --help | -h) usage 0 ;;
    *) printf 'hud: unknown command %q\n\n' "$command" >&2; usage 1 ;;
esac
